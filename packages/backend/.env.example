# Server
PORT=3001
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=yuncbaowen

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-this-too
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# AES Encryption for API Keys
AES_SECRET_KEY=32-char-secret-key-change-in-prod
AES_IV=16-char-iv-change

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=20971520

# CORS
FRONTEND_URL=http://localhost:5173

# Rate Limit
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_LOGIN=5
RATE_LIMIT_MAX_AI=60
